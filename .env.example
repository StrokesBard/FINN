# Copy this file to `.env` (same folder) and fill in the value there.
# `.env` is gitignored; this example file holds no secrets and can be committed.

# Anthropic API key for model extraction (`python -m finn enrich`).
# Leave it empty and FINN still runs, showing only rules-and-parsing output.
ANTHROPIC_API_KEY=

# Set to "off" to disable model extraction even when a key is present.
# FINN_LLM=off
