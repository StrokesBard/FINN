root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,md,html,css,js,ts,tsx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[pipeline/tests/fixtures/**]
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
